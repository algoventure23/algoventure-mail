# HTTP server port
PORT=3000

# Secret key - callers must send this in the X-API-Key header.
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# SMTP server settings (the account used to actually send mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
# true = port 465 (SSL), false = port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password

# Optional: From address shown on outgoing mail. Defaults to SMTP_USER.
# Most SMTP providers require this to match the authenticated account/domain.
MAIL_FROM="Your Name <you@yourdomain.com>"
