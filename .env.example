# ── Relay 自身设置 ──────────────────────────────
# HTTP 端口
PORT=3000
# 调用方必须在 X-API-Key header 里带上这个值
# 生成方式: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# ── SMTP 连接默认值（Titan Email）───────────────
# 注意：不再配置 SMTP_USERNAME / SMTP_PASSWORD。
# 邮箱账号密码现在由调用方在每次 POST /send 请求体里传入（smtpUsername / smtpPassword），
# 这样一个 relay 可以代发多个邮箱。这里只保留 host/port/encryption 作为请求未覆盖时的默认值。
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
# tls = 587 端口 STARTTLS，ssl = 465 端口
SMTP_ENCRYPTION=tls
# 0 = 关闭调试日志，>0 = 在 pm2 logs 里输出完整 SMTP 通信过程
SMTP_DEBUG=0
