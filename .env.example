# ── Relay 自身设置 ──────────────────────────────
# HTTP 端口
PORT=3000
# 调用方必须在 X-API-Key header 里带上这个值
# 生成方式: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# ── SMTP 设置（Titan Email）────────────────────
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USERNAME=user@email.com
SMTP_PASSWORD=password
# tls = 587 端口 STARTTLS，ssl = 465 端口
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=user@email.com
SMTP_FROM_NAME=user
# 0 = 关闭调试日志，>0 = 在 pm2 logs 里输出完整 SMTP 通信过程
SMTP_DEBUG=0
